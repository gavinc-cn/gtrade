# ============================================
# GTrade 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=
DB_HOST=localhost
DB_PORT=3307
DB_USER=gtrade
DB_PASSWORD=
DB_NAME=gtrade

# ---------- Web 服务 ----------
WEB_USER=
WEB_PASSWORD=
SECRET_KEY=

# ---------- JWT ----------
JWT_SECRET=

# ---------- Anthropic API ----------
ANTHROPIC_API_KEY=

# ---------- 代理 ----------
HTTP_PROXY_HOST=
HTTP_PROXY_PORT=10808

# ---------- gRPC / Desktop Gateway ----------
GRPC_SERVER_ADDRESS=0.0.0.0:50051

# ---------- MCP Server ----------
FLASK_BASE_URL=http://127.0.0.1:5000
HTTP_GW_BASE_URL=http://127.0.0.1:46012
FLASK_USERNAME=
FLASK_PASSWORD=

# ---------- GTrade HTTP Gateway ----------
GTRADE_HTTP_GATEWAY=http://127.0.0.1:46012
